<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SSOT for com.blender-mcp.api LaunchAgent.
  Placeholders are substituted by deploy/launchd/install.sh:
    __PROJECT_ROOT__   → repo root (e.g. /Users/<you>/Blender_MCP_drawer)
    __CONDA_PYTHON__   → conda env python (e.g. $HOME/miniconda3/envs/blender-mcp/bin/python)
  Do NOT install this file directly with `cp`; use install.sh.
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>BLENDER_HOST</key>
		<string>localhost</string>
		<key>BLENDER_PORT</key>
		<string>9876</string>
		<key>CORS_ORIGINS</key>
		<string>https://bearmacminimac-mini.tail56c751.ts.net</string>
		<key>REQUIRE_TAILNET_IDENTITY</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.blender-mcp.api</string>
	<key>ProgramArguments</key>
	<array>
		<string>__CONDA_PYTHON__</string>
		<string>-c</string>
		<string>import uvicorn; uvicorn.run('api.main:app', host='127.0.0.1', port=19505, log_level='info')</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/blender-mcp-api.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/blender-mcp-api.log</string>
	<key>WorkingDirectory</key>
	<string>__PROJECT_ROOT__</string>
</dict>
</plist>
